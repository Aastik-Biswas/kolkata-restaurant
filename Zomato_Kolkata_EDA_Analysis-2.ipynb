      "source": [
        "clean_df = df.copy()\n",
        "\n",
        "# Remove duplicate rows\n",
        "duplicate_count = clean_df.duplicated().sum()\n",
        "clean_df = clean_df.drop_duplicates().reset_index(drop=True)\n",
        "\n",
        "# Convert ratings to numeric\n",
        "rating_columns = [\"Dinner Ratings\", \"Delivery Ratings\"]\n",
        "\n",
        "for col in rating_columns:\n",
        "    clean_df[col] = pd.to_numeric(clean_df[col], errors=\"coerce\")\n",
        "\n",
        "# Ensure cost and review columns are numeric\n",
        "numeric_columns = [\n",
        "    \"Dinner Reviews\",\n",
        "    \"Delivery Reviews\",\n",
        "    \"AverageCost\"\n",
        "]\n",
        "\n",
        "for col in numeric_columns:\n",
        "    clean_df[col] = pd.to_numeric(clean_df[col], errors=\"coerce\")\n",
        "\n",
        "# Fill missing descriptive fields\n",
        "text_columns = [\"Timing\", \"KnownFor\", \"PopularDishes\", \"PeopleKnownFor\"]\n",
        "\n",
        "for col in text_columns:\n",
        "    if col in clean_df.columns:\n",
        "        clean_df[col] = clean_df[col].fillna(\"Unknown\")\n",
        "\n",
        "print(\"Duplicate rows removed:\", duplicate_count)\n",
        "print(\"Cleaned shape:\", clean_df.shape)\n",
        "\n",
        "print(\"\\nRemaining missing values:\")\n",
        "print(clean_df.isnull().sum().sort_values(ascending=False))\n"
      ]
    },
